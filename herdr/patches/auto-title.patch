diff --git a/internal/resolver/icons.go b/internal/resolver/icons.go
new file mode 100644
index 0000000..a25cbef
--- /dev/null
+++ b/internal/resolver/icons.go
@@ -0,0 +1,87 @@
+package resolver
+
+import (
+	"github.com/kryptamine/herdr-auto-title/internal/state"
+	"github.com/rivo/uniseg"
+	"strings"
+)
+
+// Iconed decorates the same pane that supplies the title, inside its width budget.
+type Iconed struct {
+	inner     TitleResolver
+	maxLength int
+}
+
+func NewIconed(inner TitleResolver, maxLength int) *Iconed {
+	if maxLength <= 0 {
+		maxLength = DefaultMaxLength
+	}
+
+	return &Iconed{inner: inner, maxLength: maxLength}
+}
+
+func (i *Iconed) Resolve(tab state.TabState) Decision {
+	decision := i.inner.Resolve(tab)
+	prefix := paneIcon(state.SelectContextPane(tab)) + " "
+
+	room := i.maxLength - uniseg.StringWidth(prefix)
+	if room <= 0 {
+		return decision
+	}
+
+	name := truncate(decision.Name, room)
+	if name != "" {
+		decision.Name = prefix + name
+	}
+
+	return decision
+}
+
+func paneIcon(pane *state.PaneState) string {
+	if pane == nil {
+		return ""
+	}
+
+	if pane.HasAgent() {
+		switch strings.ToLower(pane.Agent) {
+		case "claude":
+			return ""
+		case "codex":
+			return "󰚩"
+		case "gemini":
+			return ""
+		default:
+			return "󰚩"
+		}
+	}
+
+	for _, process := range pane.Processes {
+		name := strings.TrimSuffix(strings.ToLower(process.Name), ".exe")
+		if _, shell := shellNames[name]; shell {
+			continue
+		}
+
+		switch name {
+		case "nvim", "vim", "vi":
+			return ""
+		case "yazi":
+			return ""
+		case "git", "lazygit":
+			return ""
+		case "python", "python3":
+			return ""
+		case "node", "npm":
+			return ""
+		case "cargo", "rustc":
+			return ""
+		case "ssh":
+			return "󰣀"
+		case "top", "htop", "btop":
+			return ""
+		default:
+			return ""
+		}
+	}
+
+	return ""
+}
diff --git a/internal/resolver/icons_test.go b/internal/resolver/icons_test.go
new file mode 100644
index 0000000..74f0ed3
--- /dev/null
+++ b/internal/resolver/icons_test.go
@@ -0,0 +1,75 @@
+package resolver
+
+import (
+	"github.com/kryptamine/herdr-auto-title/internal/state"
+	"github.com/rivo/uniseg"
+	"strings"
+	"testing"
+)
+
+func TestIconSelection(t *testing.T) {
+	tests := []struct {
+		name string
+		pane *state.PaneState
+		want string
+	}{
+		{"no pane", nil, ""},
+		{
+			"agent before process",
+			&state.PaneState{Agent: "claude", Processes: []state.Process{{Name: "node"}}},
+			"",
+		},
+		{"codex", &state.PaneState{Agent: "codex"}, "󰚩"},
+		{"unknown agent", &state.PaneState{Agent: "future-agent"}, "󰚩"},
+		{"editor", &state.PaneState{Processes: []state.Process{{Name: "nvim.exe"}}}, ""},
+		{"yazi", &state.PaneState{Processes: []state.Process{{Name: "yazi"}}}, ""},
+		{"shell", &state.PaneState{Processes: []state.Process{{Name: "fish"}}}, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := paneIcon(tc.pane); got != tc.want {
+				t.Fatalf("icon = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestIconNumberAndLiveTitle(t *testing.T) {
+	pane := &state.PaneState{Agent: "codex", AgentTitle: "Fix login | mikko", Focused: true}
+	tab := state.TabState{Position: 2, Panes: []*state.PaneState{pane}}
+	chain := Default(Options{MaxLength: 50, HideAgentName: true, TitleSuffix: " | mikko"})
+
+	r := NewIconed(NewNumbered(chain, 50), 50)
+	if got := r.Resolve(tab).Name; got != "󰚩 2 · Fix login" {
+		t.Fatalf("title = %q", got)
+	}
+
+	pane.AgentTitle = "Review tests | mikko"
+
+	if got := r.Resolve(tab).Name; got != "󰚩 2 · Review tests" {
+		t.Fatalf("updated title = %q", got)
+	}
+
+	pane.AgentTitle = strings.Repeat("界", 100) + " | mikko"
+
+	got := r.Resolve(tab)
+	if uniseg.StringWidth(got.Name) > 50 || !strings.HasPrefix(got.Name, "󰚩 2 · ") {
+		t.Fatalf("bad width or prefix: %q", got.Name)
+	}
+}
+
+func TestIconsFollowFocusedPane(t *testing.T) {
+	claude := &state.PaneState{ID: "a", Agent: "claude", AgentTitle: "Review", Focused: true}
+	codex := &state.PaneState{ID: "b", Agent: "codex", TerminalTitle: "Implement | mikko"}
+	tab := state.TabState{Position: 1, Panes: []*state.PaneState{claude, codex}}
+	chain := Default(Options{MaxLength: 50, HideAgentName: true, TitleSuffix: " | mikko"})
+	r := NewIconed(NewNumbered(chain, 50), 50)
+	if got := r.Resolve(tab).Name; got != " 1 · Review" {
+		t.Fatalf("focused Claude: %q", got)
+	}
+	claude.Focused = false
+	codex.Focused = true
+	if got := r.Resolve(tab).Name; got != "󰚩 1 · Implement" {
+		t.Fatalf("focused Codex: %q", got)
+	}
+}
