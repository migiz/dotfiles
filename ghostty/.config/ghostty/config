# Theme: Everforest Dark Medium (inlined so it's independent of ghostty's
# shifting builtin theme names). To switch back, comment this block and set
# `theme = catppuccin-mocha` (a ghostty builtin) instead.
# Omarchy dynamic include kept for reference; no omarchy install is present.
# config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"
background = #2d353b
foreground = #d3c6aa
cursor-color = #d3c6aa
cursor-text = #2d353b
selection-background = #475258
selection-foreground = #d3c6aa
palette = 0=#343f44
palette = 1=#e67e80
palette = 2=#a7c080
palette = 3=#dbbc7f
palette = 4=#7fbbb3
palette = 5=#d699b6
palette = 6=#83c092
palette = 7=#d3c6aa
palette = 8=#868d80
palette = 9=#e67e80
palette = 10=#a7c080
palette = 11=#dbbc7f
palette = 12=#7fbbb3
palette = 13=#d699b6
palette = 14=#83c092
palette = 15=#d3c6aa

# Font
font-family = "JetBrainsMonoNL Nerd Font"
font-style = Regular
font-size = 14

# Window
window-padding-x = 4
window-padding-y = 4
confirm-close-surface=false
resize-overlay = never

shell-integration = fish

# Cursor stlying
cursor-style = "block"
cursor-style-blink = true
#shell-integration-features = no-cursor

# Keyboard bindings
keybind = f11=toggle_fullscreen

# Launch into Fish
command = fish
